rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Consent sub-collection (audit trail — user can create but not modify/delete)
      match /consent/{docId} {
        allow create: if request.auth != null && request.auth.uid == userId;
        allow read:   if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }
    }

    // Community posts: authenticated users can read, only author can create/modify
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.authorId;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // Reports: any authenticated user can create, nobody can read from the client
    // (server-side Cloud Functions or admins handle moderation)
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
