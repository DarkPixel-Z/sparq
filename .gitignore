# Unity — Assets whitelist
# Third-party Unity Asset Store imports (BattleOfHeroes, SpartanWarriors,
# Layer Lab, Feel, Action RPG Music, etc.) total ~15GB and are reimported
# by collaborators directly from the Asset Store. Whitelist only the
# custom + curated folders the project authored or actively curates.
unity/Assets/*
!unity/Assets/Scripts/
!unity/Assets/Scripts.meta
!unity/Assets/Resources/
!unity/Assets/Resources.meta
!unity/Assets/Scene/
!unity/Assets/Scene.meta
!unity/Assets/Prefabs/
!unity/Assets/Prefabs.meta
!unity/Assets/Editor/
!unity/Assets/Editor.meta
!unity/Assets/Plugins/
!unity/Assets/Plugins.meta
!unity/Assets/Art/
!unity/Assets/Art.meta
!unity/Assets/Audio/
!unity/Assets/Audio.meta
!unity/Assets/Fonts/
!unity/Assets/Fonts.meta
!unity/Assets/Tilemap/
!unity/Assets/Tilemap.meta
!unity/Assets/_TXT/
!unity/Assets/_TXT.meta
